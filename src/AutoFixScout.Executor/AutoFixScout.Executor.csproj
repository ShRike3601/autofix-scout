<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <DefineConstants>$(DefineConstants);AFS_EXECUTOR</DefineConstants>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- English only: drops the localized resource folders of the packages from the install -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Faster start: precompiled code (applies to dotnet publish -r ...). Tiered PGO re-optimizes hot code after start. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
    <!-- Same code as the app, so both agree on what "the previous driver" is. -->
    <Compile Include="../AutoFixScout/Drivers/DriverStore.cs" Link="DriverStore.cs" />
    <Compile Include="../AutoFixScout/Repair/ServiceDefaults.cs" Link="Repair/ServiceDefaults.cs" />
    <Compile Include="../AutoFixScout/Repair/HostsFile.cs" Link="Repair/HostsFile.cs" />
    <Compile Include="../AutoFixScout/Repair/SystemPath.cs" Link="Repair/SystemPath.cs" />
    <Compile Include="../AutoFixScout/Repair/WifiTuning.cs" Link="Repair/WifiTuning.cs" />
    <Compile Include="../AutoFixScout/Repair/OfficeClickToRun.cs" Link="Repair/OfficeClickToRun.cs" />
    <Compile Include="../AutoFixScout/Repair/BrowserPolicies.cs" Link="Repair/BrowserPolicies.cs" />
    <!-- Parsers and the result file format of the read-only diag actions: the same code the app uses to validate the result. -->
    <Compile Include="../AutoFixScout/Probes/StartupTimings.Parse.cs" Link="Probes/StartupTimings.Parse.cs" />
    <Compile Include="../AutoFixScout/Probes/BlueScreenReports.cs" Link="Probes/BlueScreenReports.cs" />
    <Compile Include="../AutoFixScout/Probes/DiagResults.cs" Link="Probes/DiagResults.cs" />
  </ItemGroup>

</Project>
