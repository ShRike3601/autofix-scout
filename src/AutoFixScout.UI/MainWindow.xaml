<Window x:Class="AutoFixScout.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoFix Scout" Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" Background="#F5F5F5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="What's wrong?" FontSize="32" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,20,0,30" Foreground="#333333"/>

            <Button Content="My sound isn't working" FontSize="24" FontWeight="SemiBold"
                    Margin="0,0,0,15" Padding="20,15" BorderThickness="2"
                    BorderBrush="#0078D4" Background="White" Foreground="#333333"
                    Click="OnSoundClicked"/>
            <Button Content="My camera isn't working" FontSize="24" FontWeight="SemiBold"
                    Margin="0,0,0,15" Padding="20,15" BorderThickness="2"
                    BorderBrush="#D93F08" Background="White" Foreground="#333333"
                    Click="OnCameraClicked"/>
            <Button Content="I can't get online" FontSize="24" FontWeight="SemiBold"
                    Margin="0,0,0,15" Padding="20,15" BorderThickness="2"
                    BorderBrush="#107C10" Background="White" Foreground="#333333"
                    Click="OnNetworkClicked"/>
            <Button Content="Something else" FontSize="18" Padding="20,12" Margin="0,0,0,25"
                    BorderBrush="#666666" Background="Transparent" Foreground="#555555"
                    Click="OnOtherClicked"/>
            <Button Content="Details for my helper" FontSize="14" Padding="20,10"
                    HorizontalAlignment="Center" BorderBrush="#999999"
                    Background="Transparent" Foreground="#666666"
                    Click="OnHelperDetailsClicked"/>
        </StackPanel>

        <Button Grid.Row="1" Content="Settings" FontSize="14" Padding="14,8" Margin="0,20,0,0"
                HorizontalAlignment="Right" BorderBrush="#CCCCCC" Background="Transparent"
                Foreground="#666666" Click="OnSettingsClicked"/>
    </Grid>
</Window>