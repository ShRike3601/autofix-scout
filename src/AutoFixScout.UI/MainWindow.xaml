<?xml version="1.0" encoding="utf-8"?>
<!-- MainWindow.xaml: Simple mode home screen (section 4) -->
<Window x:Class="AutoFixScout.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoFix Scout" Height="720" Width="540" WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize" Background="#F5F5F5">

    <!-- Large, high-contrast buttons (section 4.2) -->
    <Grid Margin="20">
        <TextBlock Text="What's wrong?" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center"
                   VerticalAlignment="Top" Margin="0,20,0,40" Foreground="#333333"/>

        <!-- Three large buttons -->
        <Button Content="My sound isn't working" FontSize="24" FontWeight="SemiBold" Margin="0,10,0,15"
                Padding="20,15" BorderThickness="2" BorderBrush="#0078D4" Background="White" Foreground="#333333"
                Click="OnSoundClicked"/>
        <Button Content="My camera isn't working" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,15"
                Padding="20,15" BorderThickness="2" BorderBrush="#D93F08" Background="White" Foreground="#333333"
                Click="OnCameraClicked"/>
        <Button Content="I can't get online" FontSize="24" FontWeight="SemiBold" Margin="0,10,0,15"
                Padding="20,15" BorderThickness="2" BorderBrush="#107C10" Background="White" Foreground="#333333"
                Click="OnNetworkClicked"/>

        <!-- Something else (LLM text/voice input) -->
        <Button Content="Something else" FontSize="18" Padding="20,12" Margin="0,5"
                BorderBrush="#666666" Background="Transparent" Foreground="#555555"
                Click="OnOtherClicked"/>

        <!-- Footer: helper details link -->
        <Button Content="Details for my helper" FontSize="14" Padding="20,10" Margin="0,30"
                BorderBrush="#999999" Background="Transparent" Foreground="#666666" HorizontalAlignment="Center"
                Click="OnHelperDetailsClicked"/>

        <!-- Settings icon -->
        <Button Content="⚙️" FontSize="28" Width="44" Height="44" Margin="0,15" VerticalAlignment="Bottom"
                HorizontalAlignment="Right" BorderBrush="#CCCCCC" Background="Transparent" Foreground="#666666"
                Click="OnSettingsClicked"/>
    </Grid>

</Window>
