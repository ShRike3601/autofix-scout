<Window x:Class="AutoFixScout.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoFix Scout" Width="600" MinHeight="520" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" Background="#F5F5F5">
    <Window.Resources>
        <Style x:Key="BigButton" TargetType="Button">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,15"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#0078D4"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Home: three symptoms + something else (spec 4.1) -->
        <StackPanel x:Name="HomePanel" Grid.Row="0">
            <TextBlock Text="What's wrong?" FontSize="32" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,20,0,30" Foreground="#1A1A1A"/>
            <Button Style="{StaticResource BigButton}" Content="My sound isn't working" Click="OnSoundClicked"/>
            <Button Style="{StaticResource BigButton}" Content="My camera isn't working" BorderBrush="#D93F08" Click="OnCameraClicked"/>
            <Button Style="{StaticResource BigButton}" Content="I can't get online" BorderBrush="#107C10" Click="OnNetworkClicked"/>
            <Button Content="Something else" FontSize="18" Padding="20,12" Margin="0,0,0,10"
                    BorderBrush="#666666" Background="Transparent" Foreground="#444444" Click="OnOtherClicked"/>
        </StackPanel>

        <!-- Step screen: one sentence, at most two choices (spec 4.2: one decision per screen) -->
        <StackPanel x:Name="StepPanel" Grid.Row="0" Visibility="Collapsed" VerticalAlignment="Center">
            <TextBlock x:Name="StepText" FontSize="26" TextWrapping="Wrap" Foreground="#1A1A1A"
                       Margin="0,20,0,30" LineHeight="36"/>
            <Button x:Name="PrimaryButton" Style="{StaticResource BigButton}" IsDefault="True" Click="OnPrimaryClicked"/>
            <Button x:Name="SecondaryButton" Style="{StaticResource BigButton}" BorderBrush="#666666" IsCancel="True" Click="OnSecondaryClicked"/>
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,20,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Details for my helper" FontSize="14" Padding="14,8"
                    BorderBrush="#999999" Background="Transparent" Foreground="#444444" Click="OnHelperDetailsClicked"/>
            <Button DockPanel.Dock="Right" Content="Settings" FontSize="14" Padding="14,8"
                    BorderBrush="#CCCCCC" Background="Transparent" Foreground="#444444" Click="OnSettingsClicked"/>
        </DockPanel>
    </Grid>
</Window>
