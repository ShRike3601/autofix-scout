<Window x:Class="AutoFixScout.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoFix Scout" Width="680" Height="720" MinWidth="420" MinHeight="460"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource TextFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <Grid MaxWidth="640" Margin="28,20,28,12">

                <!-- Home: three symptoms + something else (spec 4.1) -->
                <StackPanel x:Name="HomePanel" VerticalAlignment="Center" KeyboardNavigation.DirectionalNavigation="Contained">
                    <StackPanel x:Name="HomeHeader">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource AccentBrush}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE90F;" FontSize="16" Foreground="{DynamicResource OnAccentBrush}"/>
                            </Border>
                            <TextBlock Text="AutoFix Scout" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="{StaticResource CaptionSize}"
                                       FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="What's wrong?" FontFamily="{StaticResource DisplayFont}" FontSize="{StaticResource TitleSize}"
                                   FontWeight="SemiBold" Margin="0,18,0,22" AutomationProperties.HeadingLevel="Level1"/>
                    </StackPanel>

                    <Border x:Name="SoundCardHost">
                        <Button Style="{StaticResource CardButton}" Click="OnSoundClicked" AutomationProperties.Name="My sound isn't working">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="56" Height="56" CornerRadius="14" Background="{DynamicResource SoundTileBrush}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE767;" FontSize="26" Foreground="{DynamicResource SoundGlyphBrush}"/>
                                </Border>
                                <TextBlock x:Name="SoundTitle" Grid.Column="1" Text="My sound isn't working" Margin="18,0,12,0" VerticalAlignment="Center"
                                           FontSize="{StaticResource CardTitleSize}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="2" Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Grid>
                        </Button>
                    </Border>

                    <Border x:Name="CameraCardHost">
                        <Button Style="{StaticResource CardButton}" Click="OnCameraClicked" AutomationProperties.Name="My camera isn't working">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="56" Height="56" CornerRadius="14" Background="{DynamicResource CameraTileBrush}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE722;" FontSize="26" Foreground="{DynamicResource CameraGlyphBrush}"/>
                                </Border>
                                <TextBlock x:Name="CameraTitle" Grid.Column="1" Text="My camera isn't working" Margin="18,0,12,0" VerticalAlignment="Center"
                                           FontSize="{StaticResource CardTitleSize}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="2" Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Grid>
                        </Button>
                    </Border>

                    <Border x:Name="NetworkCardHost">
                        <Button Style="{StaticResource CardButton}" Click="OnNetworkClicked" AutomationProperties.Name="I can't get online">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="56" Height="56" CornerRadius="14" Background="{DynamicResource NetworkTileBrush}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE701;" FontSize="26" Foreground="{DynamicResource NetworkGlyphBrush}"/>
                                </Border>
                                <TextBlock x:Name="NetworkTitle" Grid.Column="1" Text="I can't get online" Margin="18,0,12,0" VerticalAlignment="Center"
                                           FontSize="{StaticResource CardTitleSize}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="2" Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Grid>
                        </Button>
                    </Border>

                    <Border x:Name="OtherHost" HorizontalAlignment="Left" Margin="-4,2,0,0">
                        <Button Style="{StaticResource SubtleButton}" Content="Something else" Tag="&#xE897;"
                                FontSize="18" Padding="14,11" Foreground="{DynamicResource TextSecondaryBrush}" Click="OnOtherClicked"/>
                    </Border>
                </StackPanel>

                <!-- Step screen: one sentence, at most two choices (spec 4.2: one decision per screen) -->
                <Border x:Name="StepPanel" Visibility="Collapsed" VerticalAlignment="Center"
                        Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="14" Padding="32,30,32,32">
                    <StackPanel x:Name="StepContent">
                        <!-- One of: topic tile, busy ring, animated check -->
                        <Grid Width="64" Height="64" HorizontalAlignment="Left" Margin="0,0,0,22">
                            <Border x:Name="StepTile" CornerRadius="16" RenderTransformOrigin="0.5,0.5">
                                <TextBlock x:Name="StepGlyph" Style="{StaticResource Icon}" FontSize="30"/>
                            </Border>
                            <Grid x:Name="BusyRing" Width="56" Height="56" Visibility="Collapsed">
                                <Ellipse Stroke="{DynamicResource RingTrackBrush}" StrokeThickness="5"/>
                                <Path Stroke="{DynamicResource AccentBrush}" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M 28,2.5 A 25.5,25.5 0 0 1 53.5,28">
                                    <Path.RenderTransform>
                                        <RotateTransform x:Name="BusyRotate" CenterX="28" CenterY="28"/>
                                    </Path.RenderTransform>
                                </Path>
                            </Grid>
                            <Grid x:Name="CheckMark" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="CheckScale"/>
                                </Grid.RenderTransform>
                                <Ellipse x:Name="CheckCircle"/>
                                <Path x:Name="CheckPath" StrokeThickness="4.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" StrokeDashArray="9 9" StrokeDashOffset="0"
                                      Data="M 20,33 L 28,41 L 45,23"/>
                            </Grid>
                        </Grid>

                        <TextBlock x:Name="StepTopic" Visibility="Collapsed" Margin="0,0,0,8" FontSize="{StaticResource CaptionSize}"
                                   FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="StepText" FontFamily="{StaticResource DisplayFont}" FontSize="{StaticResource MessageSize}"
                                   TextWrapping="Wrap" LineHeight="34" Margin="0,0,0,28"
                                   AutomationProperties.LiveSetting="Assertive"/>

                        <StackPanel x:Name="StepButtons">
                            <Button x:Name="PrimaryButton" Style="{StaticResource AccentButton}" IsDefault="True" Click="OnPrimaryClicked"/>
                            <Button x:Name="SecondaryButton" Style="{StaticResource StandardButton}" Margin="0,12,0,0" IsCancel="True" Click="OnSecondaryClicked"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerBrush}" Padding="20,8,20,10">
            <DockPanel LastChildFill="False">
                <Button x:Name="HelperButton" DockPanel.Dock="Left" Style="{StaticResource SubtleButton}" Content="Details for my helper"
                        Tag="&#xE8A5;" Click="OnHelperDetailsClicked"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Content="Settings" Tag="&#xE713;"
                        Foreground="{DynamicResource TextSecondaryBrush}" Click="OnSettingsClicked"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
