<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 19041: the weekly check-up shows its notification through the Windows toast API. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AutoFixScout.UI</RootNamespace>
    <LangVersion>latest</LangVersion>
    <!-- Packaging for portable installer -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- English only: drops the localized resource folders of the packages from the install -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Faster start: precompiled code (applies to dotnet publish -r ...). Tiered PGO re-optimizes hot code after start. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../AutoFixScout/AutoFixScout.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoFixScout.Executor\AutoFixScout.Executor.csproj" />
  </ItemGroup>

</Project>
