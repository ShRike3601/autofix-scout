<!--
  Illustrations, drawn as layered vector shapes on a 64 x 64 grid (scaled by a Viewbox, so any size is sharp).
  Each is a ControlTemplate for a ContentControl: <ContentControl Template="{StaticResource ArtSound}" Width="64" Height="64"/>.
  Colours are palette keys, so light, dark and high contrast all work. Named parts ("Check") are animated in code.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- App mark: a magnifier with a tick, on a blue tile. -->
    <ControlTemplate x:Key="ArtLogo" TargetType="ContentControl">
        <Viewbox>
            <Canvas Width="64" Height="64">
                <Canvas.Clip><RectangleGeometry Rect="0,0,64,64" RadiusX="17" RadiusY="17"/></Canvas.Clip>
                <Rectangle Width="64" Height="64" RadiusX="17" RadiusY="17" Fill="{DynamicResource LogoBrush}"/>
                <Ellipse Canvas.Left="-14" Canvas.Top="-26" Width="64" Height="52" Fill="{DynamicResource ArtHighlightBrush}" Opacity="0.22"/>
                <Ellipse Canvas.Left="13" Canvas.Top="12" Width="30" Height="30" Stroke="{DynamicResource LogoGlyphBrush}" StrokeThickness="5"/>
                <Path Data="M39,38.5 L49.5,49" Stroke="{DynamicResource LogoGlyphBrush}" StrokeThickness="6.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Path Data="M21.5,27.5 L26.5,32.5 L35,23.5" Stroke="{DynamicResource LogoAccentBrush}" StrokeThickness="4"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <!-- Sound: speaker with sound waves. -->
    <ControlTemplate x:Key="ArtSound" TargetType="ContentControl">
        <Viewbox>
            <Canvas Width="64" Height="64">
                <Canvas.Clip><RectangleGeometry Rect="0,0,64,64" RadiusX="17" RadiusY="17"/></Canvas.Clip>
                <Rectangle Width="64" Height="64" RadiusX="17" RadiusY="17" Fill="{DynamicResource SoundTileBrush}"/>
                <Ellipse Canvas.Left="-10" Canvas.Top="-22" Width="58" Height="46" Fill="{DynamicResource ArtHighlightBrush}" Opacity="0.2"/>
                <Path Data="M12,27 Q12,24.5 14.5,24.5 L20.5,24.5 L30,16.2 Q33.5,13.6 33.5,17.8 L33.5,46.2 Q33.5,50.4 30,47.8 L20.5,39.5 L14.5,39.5 Q12,39.5 12,37 Z"
                      Fill="{DynamicResource SoundGlyphBrush}"/>
                <Rectangle Canvas.Left="15" Canvas.Top="27.5" Width="3.5" Height="9" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource SoundArt2Brush}"/>
                <Path Data="M39.5,25 A9.5,9.5 0 0 1 39.5,39" Stroke="{DynamicResource SoundGlyphBrush}" Opacity="0.6" StrokeThickness="3.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Path Data="M44.5,18.5 A17,17 0 0 1 44.5,45.5" Stroke="{DynamicResource SoundGlyphBrush}" StrokeThickness="3.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <!-- Camera: webcam on a stand. -->
    <ControlTemplate x:Key="ArtCamera" TargetType="ContentControl">
        <Viewbox>
            <Canvas Width="64" Height="64">
                <Canvas.Clip><RectangleGeometry Rect="0,0,64,64" RadiusX="17" RadiusY="17"/></Canvas.Clip>
                <Rectangle Width="64" Height="64" RadiusX="17" RadiusY="17" Fill="{DynamicResource CameraTileBrush}"/>
                <Ellipse Canvas.Left="-10" Canvas.Top="-22" Width="58" Height="46" Fill="{DynamicResource ArtHighlightBrush}" Opacity="0.2"/>
                <Path Data="M32,44 L32,50 M22,51.5 L42,51.5" Stroke="{DynamicResource CameraGlyphBrush}" StrokeThickness="4"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Ellipse Canvas.Left="14" Canvas.Top="10" Width="36" Height="36" Fill="{DynamicResource CameraGlyphBrush}"/>
                <Ellipse Canvas.Left="21" Canvas.Top="17" Width="22" Height="22" Fill="{DynamicResource CameraArt2Brush}"/>
                <Ellipse Canvas.Left="26" Canvas.Top="22" Width="12" Height="12" Fill="{DynamicResource CameraGlyphBrush}"/>
                <Ellipse Canvas.Left="33.5" Canvas.Top="23" Width="4" Height="4" Fill="{DynamicResource ArtHighlightBrush}"/>
                <Ellipse Canvas.Left="30.5" Canvas.Top="12.5" Width="3" Height="3" Fill="{DynamicResource CameraArt2Brush}"/>
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <!-- Internet: globe. -->
    <ControlTemplate x:Key="ArtNetwork" TargetType="ContentControl">
        <Viewbox>
            <Canvas Width="64" Height="64">
                <Canvas.Clip><RectangleGeometry Rect="0,0,64,64" RadiusX="17" RadiusY="17"/></Canvas.Clip>
                <Rectangle Width="64" Height="64" RadiusX="17" RadiusY="17" Fill="{DynamicResource NetworkTileBrush}"/>
                <Ellipse Canvas.Left="-10" Canvas.Top="-22" Width="58" Height="46" Fill="{DynamicResource ArtHighlightBrush}" Opacity="0.2"/>
                <Ellipse Canvas.Left="14" Canvas.Top="14" Width="36" Height="36" Fill="{DynamicResource NetworkArt2Brush}"/>
                <Ellipse Canvas.Left="24" Canvas.Top="14" Width="16" Height="36" Stroke="{DynamicResource NetworkGlyphBrush}" StrokeThickness="2.6"/>
                <Path Data="M14.5,32 L49.5,32 M17.5,23 L46.5,23 M17.5,41 L46.5,41" Stroke="{DynamicResource NetworkGlyphBrush}" StrokeThickness="2.4"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Ellipse Canvas.Left="14" Canvas.Top="14" Width="36" Height="36" Stroke="{DynamicResource NetworkGlyphBrush}" StrokeThickness="3.4"/>
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <!-- Neutral: information. -->
    <ControlTemplate x:Key="ArtNeutral" TargetType="ContentControl">
        <Viewbox>
            <Canvas Width="64" Height="64">
                <Ellipse Width="64" Height="64" Fill="{DynamicResource NeutralTileBrush}"/>
                <Ellipse Canvas.Left="11" Canvas.Top="11" Width="42" Height="42" Fill="{DynamicResource NeutralGlyphBrush}"/>
                <Ellipse Canvas.Left="29" Canvas.Top="19" Width="6" Height="6" Fill="{DynamicResource OnStatusBrush}"/>
                <Path Data="M32,30 L32,43" Stroke="{DynamicResource OnStatusBrush}" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <!-- Fixed: green check with sparkles. -->
    <ControlTemplate x:Key="ArtFixed" TargetType="ContentControl">
        <Viewbox>
            <Canvas Width="64" Height="64">
                <Ellipse Width="64" Height="64" Fill="{DynamicResource SuccessTileBrush}"/>
                <Ellipse Canvas.Left="11" Canvas.Top="11" Width="42" Height="42" Fill="{DynamicResource SuccessBrush}"/>
                <Path x:Name="Check" Data="M21.5,32.5 L28.5,39.5 L43,25" Stroke="{DynamicResource OnStatusBrush}" StrokeThickness="5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeDashArray="7 7"/>
                <Path Data="M53,3 Q54,8 59,9 Q54,10 53,15 Q52,10 47,9 Q52,8 53,3 Z" Fill="{DynamicResource SuccessBrush}" Opacity="0.75"/>
                <Path Data="M8,47 Q8.7,50.3 12,51 Q8.7,51.7 8,55 Q7.3,51.7 4,51 Q7.3,50.3 8,47 Z" Fill="{DynamicResource SuccessBrush}" Opacity="0.6"/>
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <!-- No fault found: shield with a check. -->
    <ControlTemplate x:Key="ArtAllGood" TargetType="ContentControl">
        <Viewbox>
            <Canvas Width="64" Height="64">
                <Ellipse Width="64" Height="64" Fill="{DynamicResource InfoTileBrush}"/>
                <Path Data="M32,10 L48.5,16.5 L48.5,30 C48.5,41 41.5,49 32,53.5 C22.5,49 15.5,41 15.5,30 L15.5,16.5 Z" Fill="{DynamicResource InfoBrush}"/>
                <Path Data="M32,10 L32,53.5 C22.5,49 15.5,41 15.5,30 L15.5,16.5 Z" Fill="{DynamicResource ArtHighlightBrush}" Opacity="0.18"/>
                <Path x:Name="Check" Data="M24,31.5 L29.8,37.3 L40.5,26.5" Stroke="{DynamicResource OnStatusBrush}" StrokeThickness="4.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeDashArray="7 7"/>
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <!-- Not fixed: a report prepared for the helper. -->
    <ControlTemplate x:Key="ArtNotFixed" TargetType="ContentControl">
        <Viewbox>
            <Canvas Width="64" Height="64">
                <Ellipse Width="64" Height="64" Fill="{DynamicResource CautionTileBrush}"/>
                <Path Data="M19,11 L38,11 L46,19 L46,51 Q46,53 44,53 L21,53 Q19,53 19,51 Z" Fill="{DynamicResource SurfaceBrush}"
                      Stroke="{DynamicResource CautionBrush}" StrokeThickness="2.6" StrokeLineJoin="Round"/>
                <Path Data="M38,11 L38,19 L46,19" Stroke="{DynamicResource CautionBrush}" StrokeThickness="2.6" StrokeLineJoin="Round"/>
                <Path Data="M25,27 L39,27 M25,34 L39,34 M25,41 L32,41" Stroke="{DynamicResource CautionBrush}" StrokeThickness="2.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.8"/>
                <Ellipse Canvas.Left="37" Canvas.Top="37" Width="20" Height="20" Fill="{DynamicResource CautionBrush}"/>
                <Path Data="M47,41.5 L47,47.5" Stroke="{DynamicResource OnStatusBrush}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Ellipse Canvas.Left="45.4" Canvas.Top="50" Width="3.2" Height="3.2" Fill="{DynamicResource OnStatusBrush}"/>
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <!-- Probably hardware: a chip. -->
    <ControlTemplate x:Key="ArtHardware" TargetType="ContentControl">
        <Viewbox>
            <Canvas Width="64" Height="64">
                <Ellipse Width="64" Height="64" Fill="{DynamicResource CautionTileBrush}"/>
                <Path Data="M25,13 L25,19 M32,13 L32,19 M39,13 L39,19 M25,45 L25,51 M32,45 L32,51 M39,45 L39,51 M13,25 L19,25 M13,32 L19,32 M13,39 L19,39 M45,25 L51,25 M45,32 L51,32 M45,39 L51,39"
                      Stroke="{DynamicResource CautionBrush}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Rectangle Canvas.Left="18" Canvas.Top="18" Width="28" Height="28" RadiusX="5" RadiusY="5" Fill="{DynamicResource CautionBrush}"/>
                <Rectangle Canvas.Left="25" Canvas.Top="25" Width="14" Height="14" RadiusX="2.5" RadiusY="2.5" Fill="{DynamicResource CautionTileBrush}"/>
                <Ellipse Canvas.Left="21" Canvas.Top="21" Width="3" Height="3" Fill="{DynamicResource CautionTileBrush}"/>
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <!-- Error. -->
    <ControlTemplate x:Key="ArtProblem" TargetType="ContentControl">
        <Viewbox>
            <Canvas Width="64" Height="64">
                <Ellipse Width="64" Height="64" Fill="{DynamicResource ProblemTileBrush}"/>
                <Ellipse Canvas.Left="11" Canvas.Top="11" Width="42" Height="42" Fill="{DynamicResource ProblemBrush}"/>
                <Path Data="M32,21 L32,34" Stroke="{DynamicResource OnStatusBrush}" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Ellipse Canvas.Left="29" Canvas.Top="39" Width="6" Height="6" Fill="{DynamicResource OnStatusBrush}"/>
            </Canvas>
        </Viewbox>
    </ControlTemplate>
</ResourceDictionary>
