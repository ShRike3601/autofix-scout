<!-- Dark palette. Every key here must also exist in Light.xaml and in ThemeManager.HighContrastPalette. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#202020"/>
    <SolidColorBrush x:Key="CardBrush" Color="#16FFFFFF"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#21FFFFFF"/>
    <SolidColorBrush x:Key="CardPressedBrush" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="CardHoverBorderBrush" Color="#8060CDFF"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#E62B2B2B"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#1AFFFFFF"/>
    <Color x:Key="ShadowColor">#000000</Color>
    <system:Double x:Key="ShadowOpacity">0.30</system:Double>
    <system:Double x:Key="ShadowHoverOpacity">0.45</system:Double>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#D1D1D1"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#60CDFF"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#7AD6FF"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#4FB3E3"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#000000"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1E3A55"/>
    <LinearGradientBrush x:Key="AccentFillBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#76D5FF" Offset="0"/>
        <GradientStop Color="#55C3F5" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="ButtonBrush" Color="#17FFFFFF"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="SubtleHoverBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="SubtlePressedBrush" Color="#0AFFFFFF"/>

    <SolidColorBrush x:Key="FocusOuterBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FocusInnerBrush" Color="#B3000000"/>

    <!-- Branded header: deep night blue with slow glows. -->
    <LinearGradientBrush x:Key="HeroBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0E2140" Offset="0"/>
        <GradientStop Color="#17193F" Offset="0.55"/>
        <GradientStop Color="#0D2A33" Offset="1"/>
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="HeroGlow1Brush">
        <GradientStop Color="#802F7CF6" Offset="0"/>
        <GradientStop Color="#002F7CF6" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="HeroGlow2Brush">
        <GradientStop Color="#707B5CFF" Offset="0"/>
        <GradientStop Color="#007B5CFF" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="HeroGlow3Brush">
        <GradientStop Color="#6019B3A6" Offset="0"/>
        <GradientStop Color="#0019B3A6" Offset="1"/>
    </RadialGradientBrush>
    <SolidColorBrush x:Key="HeroLineBrush" Color="#269FD4FF"/>
    <SolidColorBrush x:Key="HeroBorderBrush" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="HeroTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HeroSubtextBrush" Color="#D5DCEA"/>

    <LinearGradientBrush x:Key="LogoBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3A9BFF" Offset="0"/>
        <GradientStop Color="#1A5FD0" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="LogoGlyphBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="LogoAccentBrush" Color="#8BF0D0"/>

    <SolidColorBrush x:Key="StepTrackBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="StepPendingFillBrush" Color="#1AFFFFFF"/>

    <LinearGradientBrush x:Key="SoundTileBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#21436B" Offset="0"/>
        <GradientStop Color="#142B49" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SoundGlyphBrush" Color="#AEDBFF"/>
    <SolidColorBrush x:Key="SoundArt2Brush" Color="#4E9BE8"/>
    <LinearGradientBrush x:Key="CameraTileBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#55301F" Offset="0"/>
        <GradientStop Color="#3A1F15" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CameraGlyphBrush" Color="#FFC8A8"/>
    <SolidColorBrush x:Key="CameraArt2Brush" Color="#E07A42"/>
    <LinearGradientBrush x:Key="NetworkTileBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#22482B" Offset="0"/>
        <GradientStop Color="#16301F" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="NetworkGlyphBrush" Color="#AAEBB8"/>
    <SolidColorBrush x:Key="NetworkArt2Brush" Color="#3FAE66"/>
    <SolidColorBrush x:Key="NeutralTileBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="NeutralGlyphBrush" Color="#E6E6E6"/>
    <SolidColorBrush x:Key="ArtHighlightBrush" Color="#59FFFFFF"/>

    <SolidColorBrush x:Key="SuccessTileBrush" Color="#243D20"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#7DDB6F"/>
    <SolidColorBrush x:Key="InfoTileBrush" Color="#16395A"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#9BD4FF"/>
    <SolidColorBrush x:Key="CautionTileBrush" Color="#45361A"/>
    <SolidColorBrush x:Key="CautionBrush" Color="#FFD866"/>
    <SolidColorBrush x:Key="ProblemTileBrush" Color="#4A2226"/>
    <SolidColorBrush x:Key="ProblemBrush" Color="#FF9AA3"/>
    <SolidColorBrush x:Key="OnStatusBrush" Color="#000000"/>
    <SolidColorBrush x:Key="RingTrackBrush" Color="#29FFFFFF"/>
</ResourceDictionary>
