<!-- Dark palette (the default look). Every key here must also exist in Light.xaml and in ThemeManager.HighContrastPalette. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Surfaces: flat and solid. Sidebar is the darkest, the page one step up, cards one step above that. -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#121215"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#0B0B0D"/>
    <SolidColorBrush x:Key="CardBrush" Color="#1A1A1E"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#212126"/>
    <SolidColorBrush x:Key="CardPressedBrush" Color="#17171A"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#28282E"/>
    <SolidColorBrush x:Key="CardHoverBorderBrush" Color="#3F6FB5"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1A1A1E"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#232328"/>
    <SolidColorBrush x:Key="InputBrush" Color="#0B0B0D"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#2E2E35"/>

    <!-- Text: primary ~16:1, secondary ~7:1 on the page background. -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F1F1F3"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A1A1AB"/>

    <!-- Accent. AccentBrush = icons, links and lines on dark surfaces; AccentFillBrush = filled controls under white text (~4.7:1). -->
    <SolidColorBrush x:Key="AccentBrush" Color="#5AA2FF"/>
    <SolidColorBrush x:Key="AccentFillBrush" Color="#2670E8"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#3A80F0"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#1F5FCC"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#152440"/>

    <SolidColorBrush x:Key="ButtonBrush" Color="#25252A"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#2F2F35"/>
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#1F1F23"/>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#36363D"/>
    <SolidColorBrush x:Key="SubtleHoverBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="SubtlePressedBrush" Color="#0AFFFFFF"/>
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#16FFFFFF"/>
    <SolidColorBrush x:Key="CloseHoverBrush" Color="#C42B1C"/>

    <SolidColorBrush x:Key="FocusOuterBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FocusInnerBrush" Color="#B3000000"/>

    <!-- App mark. -->
    <LinearGradientBrush x:Key="LogoBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3A8CFF" Offset="0"/>
        <GradientStop Color="#1F5FD0" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="LogoGlyphBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="LogoAccentBrush" Color="#8BF0D0"/>

    <!-- Journey (Check, Diagnosis, Fix, Confirm) and progress rings. -->
    <SolidColorBrush x:Key="StepTrackBrush" Color="#303037"/>
    <SolidColorBrush x:Key="StepPendingFillBrush" Color="#1A1A1E"/>
    <SolidColorBrush x:Key="RingTrackBrush" Color="#2E2E35"/>

    <!-- Status (ok / info / warning / error / neutral). Tile = soft background, Brush = icon, label and line. -->
    <SolidColorBrush x:Key="SuccessTileBrush" Color="#13281E"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#4CC38A"/>
    <SolidColorBrush x:Key="InfoTileBrush" Color="#152440"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#5AA2FF"/>
    <SolidColorBrush x:Key="CautionTileBrush" Color="#2C2410"/>
    <SolidColorBrush x:Key="CautionBrush" Color="#F0B429"/>
    <SolidColorBrush x:Key="ProblemTileBrush" Color="#33171B"/>
    <SolidColorBrush x:Key="ProblemBrush" Color="#F2707A"/>
    <SolidColorBrush x:Key="NeutralTileBrush" Color="#25252A"/>
    <SolidColorBrush x:Key="NeutralGlyphBrush" Color="#C9C9D1"/>
    <SolidColorBrush x:Key="OnStatusBrush" Color="#121215"/>
</ResourceDictionary>
