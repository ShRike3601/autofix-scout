<!--
  Shared styles. Colours come from the palette (Dark.xaml / Light.xaml / high contrast) through DynamicResource.
  The look is frosted glass on Windows 11 (acrylic backdrop, translucent surfaces, hairline borders), solid on Windows 10 and high contrast. No bold type anywhere: hierarchy comes from size, colour and the light display weight. Movement (press, page entrance) lives in
  Motion.cs so it can honour the Windows "Animation effects" setting; colour changes here are instant.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:AutoFixScout.UI"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- Typography: Segoe UI Variable on Windows 11, Segoe UI on Windows 10. -->
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="TextFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Type scale: page title / card heading / tile title / body / caption / label. -->
    <system:Double x:Key="DisplaySize">24</system:Double>
    <system:Double x:Key="TitleSize">19</system:Double>
    <system:Double x:Key="CardTitleSize">14</system:Double>
    <system:Double x:Key="BodySize">13.5</system:Double>
    <system:Double x:Key="ButtonTextSize">13</system:Double>
    <system:Double x:Key="CaptionSize">12</system:Double>
    <system:Double x:Key="OverlineSize">11</system:Double>

    <CornerRadius x:Key="CardRadius">12</CornerRadius>
    <CornerRadius x:Key="ControlRadius">7</CornerRadius>

    <!-- Text styles. -->
    <Style x:Key="DisplayText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="{StaticResource DisplaySize}"/>
        <Setter Property="FontWeight" Value="Light"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="31"/>
    </Style>
    <Style x:Key="TitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="{StaticResource TitleSize}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="27"/>
    </Style>
    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
        <Setter Property="FontSize" Value="{StaticResource BodySize}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="20"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
        <Setter Property="FontSize" Value="{StaticResource CaptionSize}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style x:Key="OverlineText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
        <Setter Property="FontSize" Value="{StaticResource OverlineSize}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <!-- Heading above a group of tiles. -->
    <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource OverlineText}">
        <Setter Property="FontSize" Value="{StaticResource CaptionSize}"/>
        <Setter Property="Margin" Value="0,22,0,8"/>
    </Style>

    <!-- Keyboard focus: two-ring outline that is visible on any background. -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="9" BorderThickness="2" BorderBrush="{DynamicResource FocusOuterBrush}">
                        <Border CornerRadius="7" BorderThickness="1" BorderBrush="{DynamicResource FocusInnerBrush}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <!-- Tinted square behind an icon (home cards). -->
    <Style x:Key="IconTile" TargetType="Border">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
    </Style>

    <!-- Base for every button: no chrome, our own focus ring, hand cursor, press feedback. -->
    <Style x:Key="ButtonBase" TargetType="ButtonBase">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="ui:Motion.Press" Value="True"/>
    </Style>

    <!-- Home cards (the three common problems): icon, title and caption; the border lights up on hover. -->
    <Style x:Key="CardButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="ui:Motion.HoverScale" Value="1.012"/>
        <Setter Property="ui:Motion.Glow" Value="#555AA2FF"/>
        <Setter Property="ui:Motion.Ripple" Value="#2EFFFFFF"/>
        <Setter Property="ui:Motion.RippleRadius" Value="12"/>
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="MinHeight" Value="118"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="ui:Motion.HoverLift" Value="3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Chrome" CornerRadius="{StaticResource CardRadius}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="22" ShadowDepth="6" Direction="270" Opacity="0.22" Color="#000000" RenderingBias="Performance"/>
                            </Border.Effect>
                        </Border>
                        <!-- Hover glow: faded in and out by Motion (smooth), not switched by a trigger. -->
                        <Border x:Name="Hover" CornerRadius="{StaticResource CardRadius}" Opacity="0" IsHitTestVisible="False"
                                Background="{DynamicResource CardHoverBrush}"
                                BorderBrush="{DynamicResource CardHoverBorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource CardPressedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Compact tile (the other problem areas): icon and one line of text. Tag = icon glyph, Content = text. -->
    <Style x:Key="TileButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="ui:Motion.HoverScale" Value="1.02"/>
        <Setter Property="ui:Motion.Glow" Value="#405AA2FF"/>
        <Setter Property="ui:Motion.RippleRadius" Value="12"/>
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="{StaticResource ButtonTextSize}"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="{StaticResource CardRadius}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Icon}" Text="{TemplateBinding Tag}" FontSize="16"
                                       Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Text="{TemplateBinding Content}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource CardHoverBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource CardPressedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary answer on a step screen: solid accent. -->
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="ui:Motion.HoverScale" Value="1.045"/>
        <Setter Property="ui:Motion.Glow" Value="#B02F7DFF"/>
        <Setter Property="ui:Motion.Ripple" Value="#66FFFFFF"/>
        <Setter Property="Background" Value="{DynamicResource AccentFillBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="{StaticResource ButtonTextSize}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Padding" Value="18,6"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="MinWidth" Value="112"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="{StaticResource ControlRadius}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="False"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="TextAlignment" Value="Center"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary answer ("No", "Not now"): same size, quieter. -->
    <Style x:Key="StandardButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="ui:Motion.HoverScale" Value="1.035"/>
        <Setter Property="ui:Motion.Glow" Value="#40FFFFFF"/>
        <Setter Property="ui:Motion.Ripple" Value="#40FFFFFF"/>
        <Setter Property="Background" Value="{DynamicResource ButtonBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="{StaticResource ButtonTextSize}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Padding" Value="18,6"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="MinWidth" Value="112"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="{StaticResource ControlRadius}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="False"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="TextAlignment" Value="Center"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ButtonPressedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sidebar action: text with an icon, background only on hover. Tag = icon glyph. -->
    <Style x:Key="SubtleButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="ui:Motion.Ripple" Value="#30FFFFFF"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="{StaticResource ButtonTextSize}"/>
        <Setter Property="Padding" Value="11,0"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="{StaticResource ControlRadius}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Icon}" Text="{TemplateBinding Tag}"
                                       FontSize="16" Margin="0,0,12,0" Foreground="{TemplateBinding Foreground}"/>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtlePressedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Header of a foldable sidebar section: full-width row, title left, chevron right (content built in code). -->
    <Style x:Key="SectionHeader" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="ui:Motion.Ripple" Value="#24FFFFFF"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Padding" Value="12,0,10,0"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="{StaticResource ControlRadius}" Background="{TemplateBinding Background}">
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Stretch" RecognizesAccessKey="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sidebar navigation item: the current page has a tinted background and an accent bar. Tag = icon glyph. -->
    <Style x:Key="NavItem" TargetType="RadioButton" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="ui:Motion.Ripple" Value="#30FFFFFF"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource ButtonTextSize}"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
        <Setter Property="GroupName" Value="Nav"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Chrome" CornerRadius="{StaticResource ControlRadius}" Background="{TemplateBinding Background}">
                        <Grid>
                            <Border x:Name="Bar" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                                    Background="{DynamicResource AccentBrush}" Visibility="Collapsed"/>
                            <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Icon}" Text="{TemplateBinding Tag}"
                                           FontSize="16" Margin="0,0,12,0" Foreground="{TemplateBinding Foreground}"/>
                                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource NavSelectedBrush}"/>
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            <Setter Property="FontWeight" Value="Normal"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Title bar buttons (minimise, maximise, close). Content = icon glyph. -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}">
                        <TextBlock Text="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtlePressedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}">
                        <TextBlock Text="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource CloseHoverBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Settings check box: small rounded box, accent fill and tick when on. -->
    <Style x:Key="Check" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
        <Setter Property="FontSize" Value="{StaticResource BodySize}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="4" VerticalAlignment="Top" Margin="0,1,0,0"
                                Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1">
                            <TextBlock x:Name="Tick" Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="11" Visibility="Collapsed"
                                       Foreground="{DynamicResource OnAccentBrush}"/>
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentFillBrush}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentFillBrush}"/>
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Thin, rounded scroll bar (only appears when the window is small). -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border CornerRadius="3" Background="{DynamicResource TextSecondaryBrush}" Opacity="0.45"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="6"/>
        <Setter Property="MinWidth" Value="6"/>
        <Setter Property="Margin" Value="0,4,3,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ScrollThumb}"/>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
    </Style>
</ResourceDictionary>
