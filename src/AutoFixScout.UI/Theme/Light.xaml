<!-- Light palette. Every key here must also exist in Dark.xaml and in ThemeManager.HighContrastPalette. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Surfaces. Cards are slightly translucent so Mica shows through on Windows 11. -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="CardBrush" Color="#EBFFFFFF"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="CardPressedBrush" Color="#F7F7F7"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#1A000000"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#14000000"/>
    <Color x:Key="ShadowColor">#000000</Color>
    <system:Double x:Key="ShadowOpacity" xmlns:system="clr-namespace:System;assembly=mscorlib">0.07</system:Double>

    <!-- Text: primary ~16:1, secondary ~8:1 on the window background. -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1B1B1B"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#474747"/>

    <!-- Accent (Windows 11 default blue, tuned for contrast). -->
    <SolidColorBrush x:Key="AccentBrush" Color="#005FB8"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1A6FC2"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#3381C9"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>

    <!-- Plain and quiet buttons. -->
    <SolidColorBrush x:Key="ButtonBrush" Color="#F2FFFFFF"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#F9F9F9"/>
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#EFEFEF"/>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#29000000"/>
    <SolidColorBrush x:Key="SubtleHoverBrush" Color="#0F000000"/>
    <SolidColorBrush x:Key="SubtlePressedBrush" Color="#08000000"/>

    <!-- Keyboard focus ring (Windows 11 style: dark outer, light inner). -->
    <SolidColorBrush x:Key="FocusOuterBrush" Color="#E4000000"/>
    <SolidColorBrush x:Key="FocusInnerBrush" Color="#B3FFFFFF"/>

    <!-- Topic tiles on the home cards. -->
    <SolidColorBrush x:Key="SoundTileBrush" Color="#DCEBFA"/>
    <SolidColorBrush x:Key="SoundGlyphBrush" Color="#005FB8"/>
    <SolidColorBrush x:Key="CameraTileBrush" Color="#FDE5DA"/>
    <SolidColorBrush x:Key="CameraGlyphBrush" Color="#B23A07"/>
    <SolidColorBrush x:Key="NetworkTileBrush" Color="#DDF2DD"/>
    <SolidColorBrush x:Key="NetworkGlyphBrush" Color="#0E6B0E"/>
    <SolidColorBrush x:Key="NeutralTileBrush" Color="#EAEAEA"/>
    <SolidColorBrush x:Key="NeutralGlyphBrush" Color="#3B3B3B"/>

    <!-- End states. -->
    <SolidColorBrush x:Key="SuccessTileBrush" Color="#DFF6DD"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#0F7B0F"/>
    <SolidColorBrush x:Key="InfoTileBrush" Color="#DCEBFA"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#005FB8"/>
    <SolidColorBrush x:Key="CautionTileBrush" Color="#FFF1CC"/>
    <SolidColorBrush x:Key="CautionBrush" Color="#8A5100"/>
    <SolidColorBrush x:Key="ProblemTileBrush" Color="#FDE7E9"/>
    <SolidColorBrush x:Key="ProblemBrush" Color="#C42B1C"/>
    <SolidColorBrush x:Key="RingTrackBrush" Color="#1F000000"/>
</ResourceDictionary>
