<!-- Light palette. Every key here must also exist in Dark.xaml and in ThemeManager.HighContrastPalette. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">
    <!-- Surfaces. Cards are slightly translucent so Mica shows through on Windows 11. -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="CardBrush" Color="#F2FFFFFF"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="CardPressedBrush" Color="#F7F7F7"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#14000000"/>
    <SolidColorBrush x:Key="CardHoverBorderBrush" Color="#66005FB8"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FAFFFFFF"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#14000000"/>
    <Color x:Key="ShadowColor">#0B2447</Color>
    <system:Double x:Key="ShadowOpacity">0.10</system:Double>
    <system:Double x:Key="ShadowHoverOpacity">0.18</system:Double>

    <!-- Text: primary ~16:1, secondary ~8:1 on the window background. -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1B1B1B"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#474747"/>

    <!-- Accent (Windows 11 default blue, tuned for contrast). -->
    <SolidColorBrush x:Key="AccentBrush" Color="#005FB8"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1A6FC2"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#3381C9"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#DCEBFA"/>
    <!-- Primary buttons: blue-to-violet sweep (white text stays above 5:1 across it). -->
    <LinearGradientBrush x:Key="AccentFillBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#005FB8" Offset="0"/>
        <GradientStop Color="#3B4FC4" Offset="0.55"/>
        <GradientStop Color="#6A3FC0" Offset="1"/>
    </LinearGradientBrush>

    <!-- Plain and quiet buttons. -->
    <SolidColorBrush x:Key="ButtonBrush" Color="#F7FFFFFF"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#F3F7FB"/>
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#EBEFF4"/>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#2E000000"/>
    <SolidColorBrush x:Key="SubtleHoverBrush" Color="#0F000000"/>
    <SolidColorBrush x:Key="SubtlePressedBrush" Color="#08000000"/>

    <!-- Keyboard focus ring (Windows 11 style: dark outer, light inner). -->
    <SolidColorBrush x:Key="FocusOuterBrush" Color="#E4000000"/>
    <SolidColorBrush x:Key="FocusInnerBrush" Color="#B3FFFFFF"/>

    <!-- Branded header: soft daylight sky with slow glows. -->
    <LinearGradientBrush x:Key="HeroBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E3EEFC" Offset="0"/>
        <GradientStop Color="#EDEBFB" Offset="0.55"/>
        <GradientStop Color="#E6F4F4" Offset="1"/>
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="HeroGlow1Brush">
        <GradientStop Color="#8C5BA8F5" Offset="0"/>
        <GradientStop Color="#005BA8F5" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="HeroGlow2Brush">
        <GradientStop Color="#7AA58BF2" Offset="0"/>
        <GradientStop Color="#00A58BF2" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="HeroGlow3Brush">
        <GradientStop Color="#7058CDB8" Offset="0"/>
        <GradientStop Color="#0058CDB8" Offset="1"/>
    </RadialGradientBrush>
    <SolidColorBrush x:Key="HeroLineBrush" Color="#1F0B3D7A"/>
    <SolidColorBrush x:Key="HeroBorderBrush" Color="#140B2447"/>
    <SolidColorBrush x:Key="HeroTextBrush" Color="#0E1B33"/>
    <SolidColorBrush x:Key="HeroSubtextBrush" Color="#3A4558"/>

    <!-- App mark. -->
    <LinearGradientBrush x:Key="LogoBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1A7BE0" Offset="0"/>
        <GradientStop Color="#0A4FA8" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="LogoGlyphBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="LogoAccentBrush" Color="#7FE3C4"/>

    <!-- Journey (Check, Diagnosis, Fix, Confirm). -->
    <SolidColorBrush x:Key="StepTrackBrush" Color="#260B2447"/>
    <SolidColorBrush x:Key="StepPendingFillBrush" Color="#B3FFFFFF"/>

    <!-- Topic illustrations: tile gradient, deep tone, light tone. -->
    <LinearGradientBrush x:Key="SoundTileBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E6F1FE" Offset="0"/>
        <GradientStop Color="#C9DFFA" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SoundGlyphBrush" Color="#0B5CAD"/>
    <SolidColorBrush x:Key="SoundArt2Brush" Color="#5AA6F0"/>
    <LinearGradientBrush x:Key="CameraTileBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FEEDE4" Offset="0"/>
        <GradientStop Color="#F8D3BF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CameraGlyphBrush" Color="#A13D0C"/>
    <SolidColorBrush x:Key="CameraArt2Brush" Color="#F08A50"/>
    <LinearGradientBrush x:Key="NetworkTileBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E4F6E7" Offset="0"/>
        <GradientStop Color="#C8EACD" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="NetworkGlyphBrush" Color="#11693A"/>
    <SolidColorBrush x:Key="NetworkArt2Brush" Color="#4CC27A"/>
    <SolidColorBrush x:Key="NeutralTileBrush" Color="#EAEAEA"/>
    <SolidColorBrush x:Key="NeutralGlyphBrush" Color="#3B3B3B"/>
    <SolidColorBrush x:Key="ArtHighlightBrush" Color="#D9FFFFFF"/>

    <!-- Status (ok / info / warning / error). Tile = soft background, Brush = icon and accent line. -->
    <SolidColorBrush x:Key="SuccessTileBrush" Color="#DFF6DD"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#0F7B0F"/>
    <SolidColorBrush x:Key="InfoTileBrush" Color="#DCEBFA"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#005FB8"/>
    <SolidColorBrush x:Key="CautionTileBrush" Color="#FFF1CC"/>
    <SolidColorBrush x:Key="CautionBrush" Color="#8A5100"/>
    <SolidColorBrush x:Key="ProblemTileBrush" Color="#FDE7E9"/>
    <SolidColorBrush x:Key="ProblemBrush" Color="#C42B1C"/>
    <SolidColorBrush x:Key="OnStatusBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="RingTrackBrush" Color="#1F000000"/>
</ResourceDictionary>
