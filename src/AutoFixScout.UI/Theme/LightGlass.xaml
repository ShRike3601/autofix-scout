<!--
  Light frosted glass (Windows 11 acrylic backdrop). Layered over Light.xaml exactly as DarkGlass.xaml is layered over Dark.xaml,
  only when ThemeManager has switched the window to the acrylic backdrop. Surfaces are translucent white over a light window
  tint (70 % opaque) so text keeps at least 4.5:1 even over a dark wallpaper. Borders are hairlines brighter at the top edge.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#B3F5F6F8"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#4DFFFFFF"/>

    <!-- Frosted card: more white at the top like light falling on glass. -->
    <LinearGradientBrush x:Key="CardBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#B3FFFFFF" Offset="0"/>
        <GradientStop Color="#80FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#CCFFFFFF" Offset="0"/>
        <GradientStop Color="#99FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CardPressedBrush" Color="#66FFFFFF"/>
    <LinearGradientBrush x:Key="CardBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E6FFFFFF" Offset="0"/>
        <GradientStop Color="#66FFFFFF" Offset="0.3"/>
        <GradientStop Color="#33FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardHoverBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#B31B63D6" Offset="0"/>
        <GradientStop Color="#661B63D6" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SurfaceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#99FFFFFF" Offset="0"/>
        <GradientStop Color="#66FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="FlyoutBrush" Color="#F7FFFFFF"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#26000000"/>
    <SolidColorBrush x:Key="InputBrush" Color="#B3FFFFFF"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#40000000"/>

    <SolidColorBrush x:Key="ButtonBrush" Color="#99FFFFFF"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#CCFFFFFF"/>
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#66FFFFFF"/>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#40000000"/>
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#1F000000"/>

    <SolidColorBrush x:Key="AccentSoftBrush" Color="#331F66DB"/>
    <SolidColorBrush x:Key="StepTrackBrush" Color="#4D000000"/>
    <SolidColorBrush x:Key="StepPendingFillBrush" Color="#99FFFFFF"/>
    <SolidColorBrush x:Key="RingTrackBrush" Color="#33000000"/>

    <!-- Status tiles stay fairly solid so the dark status text keeps its contrast. -->
    <SolidColorBrush x:Key="SuccessTileBrush" Color="#D9CBF0C8"/>
    <SolidColorBrush x:Key="InfoTileBrush" Color="#D9CFE0FA"/>
    <SolidColorBrush x:Key="CautionTileBrush" Color="#D9FBE8B0"/>
    <SolidColorBrush x:Key="ProblemTileBrush" Color="#D9FAD3D7"/>
    <SolidColorBrush x:Key="NeutralTileBrush" Color="#D9E3E6EC"/>
</ResourceDictionary>
