{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Telemetry": {
    "Enabled": false,
    "Endpoint": "https://your-telemetry-endpoint.com/api/v1/outcomes",
    "CollectFields": ["playbook_id", "playbook_version", "step_id", "tier", "result", "confirmed_fixed", "hardware_class"]
  },
  "LLM": {
    "Enabled": false,
    "Endpoint": "https://your-llm-endpoint.com/v1/classify",
    "TimeoutSeconds": 30,
    "CacheByFindingCode": true
  }
}
