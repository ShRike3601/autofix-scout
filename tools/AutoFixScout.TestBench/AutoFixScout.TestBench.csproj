<Project Sdk="Microsoft.NET.Sdk">

  <!-- Real-hardware test runner for AFS-TESTBENCH only. Not shipped with the app. See docs/HANDOFF.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AutoFixScout\AutoFixScout.csproj" />
    <!-- FixActions starts AutoFixScout.Executor.exe from this folder, like the app does. -->
    <ProjectReference Include="..\..\src\AutoFixScout.Executor\AutoFixScout.Executor.csproj" />
  </ItemGroup>

</Project>
